# Keep disabled until the dedicated production-compatible intake service is tested.
INTAKE_ENABLED=false
INTAKE_SUPABASE_URL=
INTAKE_ANON_KEY=
INTAKE_SERVICE_ROLE_KEY=
INTAKE_BUCKET=
# Stable auth user UUIDs, never emails or editable user metadata.
INTAKE_OWNER_IDS=
# Independent cryptographically random secrets, at least 32 characters each.
INTAKE_RATE_SECRET=
INTAKE_MAINTENANCE_SECRET=
# Exact comma-separated browser origins for this deployment; no wildcards.
INTAKE_SITE_ORIGINS=http://127.0.0.1:3184
